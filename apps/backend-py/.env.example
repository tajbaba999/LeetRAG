NODE_ENV=development
PORT=3000

# Database (Neon PostgreSQL)
DATABASE_URL=

# JWT Secrets
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# Gemini AI
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# LeetCode 
LEETCODE_USERNAME=
LEETCODE_SESSION=
LEETCODE_CSRF=

# Redis (ARQ job queues)
REDIS_URL=

# ChromaDB 
CHROMA_URL=http://localhost:8000
# Cloud: CHROMA_HOST + CHROMA_API_KEY + CHROMA_TENANT + CHROMA_DATABASE
CHROMA_HOST=
CHROMA_API_KEY=
CHROMA_TENANT=
CHROMA_DATABASE=

# RAG reranking
RERANK_ENABLED=true
RERANK_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
RERANK_TOP_K=5

# RAG confidence thresholds (0..1 sigmoid of top-1 rerank logit)
CONFIDENCE_LOW=0.5
CONFIDENCE_HIGH=0.8

# RAG query expansion (multi-query + HyDE)
QUERY_EXPANSION_ENABLED=true
QUERY_EXPANSION_VARIANTS=2
HYDE_ENABLED=true
